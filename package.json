{
  "name": "minikyu",
  "version": "1.12.0",
  "private": true,
  "license": "MIT",
  "author": "niskan516",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "lingui extract && lingui compile --typescript && vp build",
    "preview": "vp preview",
    "dev:web": "vp dev --mode web",
    "build:web": "lingui extract && lingui compile --typescript && vp build --mode web",
    "deploy:redirects": "bun run scripts/write-deploy-redirects.ts",
    "build:cf": "bun run build:web && cp cloudflare/_headers cloudflare/_redirects dist/",
    "preview:web": "vp preview --mode web",
    "typecheck": "tsc --noEmit && bun run typecheck:tools",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "test": "vp test",
    "test:run": "vp test run",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --project=web --project=web-mobile",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:tauri": "cd e2e-tauri && bun test",
    "test:e2e:tauri:build": "tauri build --debug --no-bundle --features webdriver",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt -- --check",
    "rust:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "rust:clippy:fix": "cd src-tauri && cargo clippy --fix --allow-dirty",
    "rust:test": "cd src-tauri && cargo test",
    "rust:bindings": "cd src-tauri && cargo test export_bindings -- --ignored --nocapture",
    "lefthook": "lefthook install",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "bun run typecheck && cd src-tauri && cargo check",
    "test:all": "bun run test:run && bun run rust:test",
    "check:all": "bun run typecheck && bun run lint && bun run ast:lint && bun run format:check && bun run rust:fmt:check && bun run rust:clippy && bun run test:run && bun run rust:test",
    "fix:all": "bun run lint:fix && bun run format && bun run rust:fmt && bun run rust:clippy:fix",
    "build:analyze": "vp build && echo '\\n📊 Bundle analysis complete. Check dist/ folder sizes or use a tool like webpack-bundle-analyzer on the dist folder.'",
    "release:prepare": "node scripts/prepare-release.js",
    "task:complete": "node scripts/complete-task.js",
    "task:rename-done": "node scripts/complete-task.js --rename-existing",
    "knip": "knip",
    "jscpd": "jscpd",
    "ast:lint": "ast-grep scan",
    "ast:fix": "ast-grep scan --fix",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "check": "vp check"
  },
  "dependencies": {
