{
  "name": "Minikyu",
  "short_name": "Minikyu",
  "description": "A Miniflux reader for the web.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
